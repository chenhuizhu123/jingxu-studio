{
  "name": "jingxu-studio",
  "version": "0.1.10",
  "private": true,
  "description": "镜序 Studio · 短剧制作与镜头返修工作台",
  "main": "dist/desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,studio \"tsx watch apps/server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.electron.config.ts",
    "check": "npm run build && npm run test:coverage && npm run test:e2e",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "node scripts/assert-windows-host.mjs && npm run build && electron-builder --win --publish never",
    "mobile:android": "cd apps/mobile && flutter build apk --release --target-platform android-arm64 --split-per-abi",
    "mobile:ios": "cd apps/mobile && flutter build ios --simulator --debug",
    "mobile:check": "cd apps/mobile && flutter analyze && flutter test",
    "format": "prettier --write apps/studio apps/server apps/desktop packages tests scripts docs README.md *.ts *.json *.yml",
    "website:build": "node apps/website/build.mjs",
    "test:package": "node scripts/verify-packaged.mjs",
    "package:win:cross": "npm run build && node scripts/package-windows.mjs",
    "test:win:structure": "node scripts/verify-windows-package.mjs",
    "test:interop": "tsx scripts/generate-project-schema.ts --check && tsx scripts/package-interop.ts",
    "mobile:verify:android": "node scripts/verify-android.mjs",
    "mobile:verify:ios-simulator": "node scripts/verify-ios-simulator.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "electron": "45.2.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.0.18"
  }
}
